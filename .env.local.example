# Copy this file to .env.local and fill in values from your Supabase project settings.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — used in API routes for admin actions (payment verification, etc).
# NEVER expose this to the browser / commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
